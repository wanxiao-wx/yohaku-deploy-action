diff --git a/apps/web/src/lib/dongxin-archive.ts b/apps/web/src/lib/dongxin-archive.ts
new file mode 100644
index 0000000..7ad0adf
--- /dev/null
+++ b/apps/web/src/lib/dongxin-archive.ts
@@ -0,0 +1,87 @@
+import type { Pager, PaginateResult, PostModel } from '@mx-space/api-client'
+
+import { apiClient } from '~/lib/request'
+
+export const DONGXIN_CATEGORY_SLUG = 'dongxin'
+export const DONGXIN_ARCHIVE_PATH = '/dongxin/'
+
+export const isDongxinPost = (item: any) =>
+  item?.category?.slug === DONGXIN_CATEGORY_SLUG
+
+export const isDongxinPostUrl = (value: unknown) => {
+  if (typeof value !== 'string') return false
+
+  try {
+    return new URL(value, 'https://local.invalid').pathname.includes(
+      `/posts/${DONGXIN_CATEGORY_SLUG}/`,
+    )
+  } catch {
+    return value.includes(`/posts/${DONGXIN_CATEGORY_SLUG}/`)
+  }
+}
+
+export const withoutDongxinPosts = <T>(items: T[]) =>
+  items.filter((item) => !isDongxinPost(item))
+
+const MAX_SOURCE_PAGE_SIZE = 100
+
+interface PublicPostListParams {
+  excludeAiWritten?: boolean
+  lang?: string
+  page?: number
+  size?: number
+  sortBy?: string
+  sortOrder?: 1 | -1
+  truncate?: number
+}
+
+/**
+ * Core does not support excluding one category. Fetch every public post,
+ * remove the private archive category, then paginate the visible set locally.
+ * This avoids empty pages and incorrect totals for every supported sort mode.
+ */
+export const getPublicPostList = async ({
+  page = 1,
+  size = 10,
+  ...params
+}: PublicPostListParams) => {
+  const first = await apiClient.post.proxy.get<PaginateResult<PostModel>>({
+    params: { ...params, page: 1, size: MAX_SOURCE_PAGE_SIZE },
+  })
+  const remainingPages = await Promise.all(
+    Array.from(
